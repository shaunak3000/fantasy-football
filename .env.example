# ESPN fantasy league access.
# LEAGUE_ID comes from the league URL: fantasy.espn.com/football/league?leagueId=123456
# ESPN_S2 and SWID are HttpOnly cookies — see README for how to pull them from devtools.
# SWID must include the surrounding curly braces.
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=

# Season to operate on. Development runs against the prior season until the 2026 league exists.
ESPN_SEASON=2026
